<idea-plugin>
    <id>com.moiseskerschner.aiinlinereviewcomments</id>
    <name>AI Inline Review Comments</name>
    <vendor>Moises Kerschner</vendor>
    <description>Select text in any editor — including the Git/Commit diff viewer panes — and press Ctrl+Shift+X to attach a review-style comment, the way GitLab's diff "add comment" works. Entirely local: the formatted comments are sent to the IDE terminal tab running Claude Code (a tab whose title contains "claude"), or copied to the clipboard when no such tab is open.</description>

    <depends>com.intellij.modules.platform</depends>
    <depends optional="true">org.jetbrains.plugins.terminal</depends>
    <depends>com.intellij.modules.jcef</depends>

    <extensions defaultExtensionNs="com.intellij">
        <editorFactoryListener implementation="com.moiseskerschner.aiinlinereviewcomments.InlineCommentEditorFactoryListener"/>
        <editorNotificationProvider implementation="com.moiseskerschner.aiinlinereviewcomments.CommentBarProvider"/>
        <postStartupActivity implementation="com.moiseskerschner.aiinlinereviewcomments.ForceTerminalOverrideShortcuts"/>
        <postStartupActivity implementation="com.moiseskerschner.aiinlinereviewcomments.PreviewShortcutDispatcher"/>
        <notificationGroup id="ai-inline-review-comments" displayType="BALLOON"/>
        <toolWindow id="Inline Comments Log" anchor="bottom" secondary="true"
                    factoryClass="com.moiseskerschner.aiinlinereviewcomments.PluginLogToolWindowFactory"/>
    </extensions>

    <actions>
        <action id="InlineComments.AddComment" class="com.moiseskerschner.aiinlinereviewcomments.AddInlineCommentAction"
                text="Add Inline Comment" description="Add a review-style comment for the selected text">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift X"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
